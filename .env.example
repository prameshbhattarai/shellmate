# Copy to .env and adjust. All values below are the defaults.

# Local model served by Ollama. 3b keeps the laptop cool; switch to qwen2.5:7b for harder tasks.
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434
# Small context on purpose: one command and its (truncated) output fit easily.
OLLAMA_NUM_CTX=4096

# Safety limits
SHELLMATE_MAX_STEPS=8
SHELLMATE_COMMAND_TIMEOUT_S=30
SHELLMATE_MAX_OUTPUT_CHARS=4000

# Where memory and checkpoints are stored
SHELLMATE_HOME=~/.shellmate
